rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && userDoc().data.active == true;
    }

    function role() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return activeUser() && role() == "admin";
    }

    function isEmployee() {
      return activeUser() && role() == "empleado";
    }

    function isClient() {
      return activeUser() && role() == "cliente";
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function enrolled(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId))
        && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)).data.active == true;
    }

    function ownsCourse(courseId) {
      return isEmployee()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      // A signed-in user must be able to read their own profile first.
      // This is required to resolve the role used by the rest of the rules;
      // putting isAdmin()/isEmployee() first here would create a circular
      // dependency while reading users/{uid}.
      allow read: if ownsUser(userId)
        || isAdmin()
        || (isEmployee() && resource.data.role == "cliente");

      // Public course-app registration can ONLY create a client profile.
      allow create: if signedIn()
        && ownsUser(userId)
        && request.resource.data.role == "cliente"
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string;

      // User administration remains available to cbdevs-admin. The course app
      // itself exposes no user-management UI or API.
      allow update: if isAdmin()
        || (
          ownsUser(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.active == resource.data.active
        );

      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAdmin()
        || ownsCourse(courseId)
        || enrolled(courseId);

      allow create: if isAdmin()
        || (
          isEmployee()
          && request.resource.data.createdBy == request.auth.uid
        );

      allow update: if isAdmin()
        || (ownsCourse(courseId) && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin() || ownsCourse(courseId);
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (
          isEmployee()
          && ownsCourse(resource.data.courseId)
        )
        || (
          isClient()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.courseId is string
        && request.resource.data.active is bool;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if isAdmin()
        || (
          isEmployee()
          && ownsCourse(resource.data.courseId)
        )
        || (
          isClient()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isClient()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courseId is string
        && enrolled(request.resource.data.courseId)
        && request.resource.data.lessonId is string
        && request.resource.data.phaseId is string
        && request.resource.data.completed is bool;

      allow update: if isClient()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.lessonId == resource.data.lessonId
        && request.resource.data.phaseId == resource.data.phaseId
        && enrolled(resource.data.courseId);

      allow delete: if isAdmin();
    }

    match /courses/{courseId}/phases/{phaseId} {
      allow read: if isAdmin() || ownsCourse(courseId) || enrolled(courseId);

      allow create: if isAdmin()
        || ownsCourse(courseId);

      allow update, delete: if isAdmin() || ownsCourse(courseId);
    }

    match /courses/{courseId}/phases/{phaseId}/lessons/{lessonId} {
      allow read: if isAdmin()
        || ownsCourse(courseId)
        || (
          enrolled(courseId)
          && resource.data.published == true
        );

      allow create: if isAdmin() || ownsCourse(courseId);
      allow update, delete: if isAdmin() || ownsCourse(courseId);
    }

  }
}

rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function active(){return signedIn() && me().active==true;}
  function admin(){return active() && me().role=="admin";}
  function employee(){return active() && me().role=="empleado";}
  function staff(){return admin()||employee();}
  function enrolled(courseId){return active() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid+"_"+courseId)) && get(/databases/$(database)/documents/enrollments/$(request.auth.uid+"_"+courseId)).data.active==true;}
  function courseAccess(courseId){return staff()||enrolled(courseId);}
  match /users/{uid}{
   allow read: if signedIn()&&(uid==request.auth.uid||admin());
   allow create: if signedIn()&&uid==request.auth.uid&&request.resource.data.role=="cliente"&&request.resource.data.active==true&&request.resource.data.email==request.auth.token.email;
   allow update: if admin() || (active()&&uid==request.auth.uid&&request.resource.data.role==resource.data.role&&request.resource.data.active==resource.data.active&&request.resource.data.email==resource.data.email);
   allow delete:false;
  }
  match /projects/{id}{allow read,create,update:if active();allow delete:if admin();}
  match /messages/{id}{allow read:if active();allow create:if active()&&request.resource.data.senderId==request.auth.uid&&request.resource.data.text!=null;allow update,delete:if admin()||(active()&&resource.data.senderId==request.auth.uid);}
  match /channels/{id}{allow read:if active();allow create,update,delete:if admin();}
  match /inquiries/{id}{allow create:if request.resource.data.name!=null&&request.resource.data.email!=null&&request.resource.data.details!=null&&request.resource.data.service!=null;allow read,update,delete:false;}
  match /clients/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow write:false;}
  match /payments/{id}{allow read:if signedIn()&&resource.data.metadata.clientUid==request.auth.uid;allow write:false;}
  match /payment_links/{id}{allow read,write:false;}
  match /courses/{courseId}{allow read:if courseAccess(courseId);allow create:if staff()&&request.resource.data.createdBy==request.auth.uid;allow update:if staff();allow delete:if admin();match /phases/{phaseId}{allow read:if courseAccess(courseId);allow create,update,delete:if staff();match /lessons/{lessonId}{allow read:if courseAccess(courseId);allow create,update,delete:if staff();}}
  match /enrollments/{id}{allow read:if staff()||(active()&&resource.data.userId==request.auth.uid);allow create:if staff();allow update:if staff();allow delete:if admin();}
  match /progress/{id}{allow read:if staff()||(active()&&resource.data.userId==request.auth.uid&&enrolled(resource.data.courseId));allow create:if active()&&request.resource.data.userId==request.auth.uid&&enrolled(request.resource.data.courseId);allow update:if active()&&resource.data.userId==request.auth.uid&&request.resource.data.userId==request.auth.uid&&resource.data.courseId==request.resource.data.courseId;allow delete:if admin();}
  match /{document=**}{allow read,write:false;}
 }
}
